# Copiar a .env y ajustar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000

# PostgreSQL local de docker-compose (en Railway se usa la variable DATABASE_URL del servicio)
DATABASE_URL=postgresql://compumundo:compumundo@localhost:5433/compumundo
DATABASE_SSL=false

# JWT (ADR-004): access 8 h, refresh 7 días. Mínimo 32 caracteres.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Administrador inicial del seed (ST-06)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
